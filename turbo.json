{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		"tsconfig.json",
		"vitest.config.js",
		".oxlintrc.json",
		".oxfmtrc.json"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"type-check": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"@tanishqkancharla/tandem-core#type-check": {
			"dependsOn": ["^build", "@tanishqkancharla/tandem-server#build"],
			"outputs": []
		},
		"lint": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"format": {
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test:e2e": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["test-results/**", "playwright-report/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"clean": {
			"cache": false
		}
	}
}
