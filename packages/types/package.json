{
	"name": "@get-halo/tandem-types",
	"version": "0.2.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"source": "./src/index.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "Tanishq Kancharla <tanishqkancharla3@gmail.com>",
	"description": "Shared TypeScript types for Tandem sync engine",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tanishqkancharla/tandem.git",
		"directory": "packages/types"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc",
		"type-check": "tsgo --noEmit",
		"format": "oxfmt \"src/**/*.ts\"",
		"lint": "oxlint src --fix && tsc --noEmit"
	},
	"dependencies": {
		"tuple-database": "^2.2.4"
	},
	"devDependencies": {
		"typescript": "^5.7.2"
	}
}
