{
	"name": "@get-halo/tandem-react",
	"version": "0.2.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"source": "./src/index.ts",
	"author": "Tanishq Kancharla <tanishqkancharla3@gmail.com>",
	"description": "React bindings for Tandem",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tanishqkancharla/tandem.git",
		"directory": "packages/react"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"type-check": "tsgo --noEmit && tsgo -p tsconfig.test.json --noEmit",
		"format": "oxfmt \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
		"lint": "oxlint src --fix && tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@get-halo/tandem-core": "workspace:*",
		"@get-halo/tandem-types": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.1.12",
		"@types/react-dom": "^19.1.9",
		"jsdom": "^26.1.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"typescript": "^5.7.2",
		"vitest": "^1.1.0"
	}
}
