{
	"name": "@tanishqkancharla/tandem-react",
	"version": "0.3.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"source": "./src/index.ts",
	"author": "Tanishq Kancharla <tanishqkancharla3@gmail.com>",
	"description": "React bindings for Tandem",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tanishqkancharla/tandem.git",
		"directory": "packages/react"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"!dist/**/*.map"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
		"prepublishOnly": "pnpm run build",
		"type-check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
		"format": "oxfmt \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
		"lint": "oxlint src --fix && tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@tanishqkancharla/tandem-core": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
