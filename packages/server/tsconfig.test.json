{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": ".",
		"noEmit": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"paths": {
			"@tanishqkancharla/tandem-core": ["../core/src/index.ts"],
			"@tanishqkancharla/tandem-server": ["./src/index.ts"]
		}
	},
	"include": ["src/**/*.ts", "test/**/*.ts"],
	"references": [
		{
			"path": "../core"
		}
	]
}
