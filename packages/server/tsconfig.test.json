{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": ".",
		"noEmit": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"paths": {
			"@tandem/core": ["../core/src/index.ts"],
			"@tandem/types": ["../types/src/index.ts"]
		}
	},
	"include": ["src/**/*.ts", "test/**/*.ts"],
	"references": [
		{
			"path": "../types"
		},
		{
			"path": "../core"
		}
	]
}
