{
	"name": "@tanishqkancharla/tandem-server",
	"version": "0.2.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"source": "./src/index.ts",
	"author": "Tanishq Kancharla <tanishqkancharla3@gmail.com>",
	"description": "Typed server database and durable storage APIs for Tandem",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tanishqkancharla/tandem.git",
		"directory": "packages/server"
	},
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"type-check": "tsgo --noEmit && tsgo -p tsconfig.test.json --noEmit",
		"format": "oxfmt \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "oxlint src --fix && tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@tanishqkancharla/tandem-core": "workspace:*",
		"errore": "^0.14.1",
		"tuple-database": "^2.2.4"
	},
	"devDependencies": {
		"@types/node": "^20.14.2",
		"typescript": "^5.7.2",
		"vitest": "^1.1.0"
	}
}
