{
	"name": "@tanishqkancharla/tandem-server",
	"version": "0.2.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"source": "./src/index.ts",
	"author": "Tanishq Kancharla <tanishqkancharla3@gmail.com>",
	"description": "Server adapters for Tandem remote APIs",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tanishqkancharla/tandem.git",
		"directory": "packages/server"
	},
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./drizzle/pg": {
			"types": "./dist/drizzle/pg.d.ts",
			"import": "./dist/drizzle/pg.js",
			"default": "./dist/drizzle/pg.js"
		},
		"./drizzle/mysql": {
			"types": "./dist/drizzle/mysql.d.ts",
			"import": "./dist/drizzle/mysql.js",
			"default": "./dist/drizzle/mysql.js"
		},
		"./drizzle/sqlite": {
			"types": "./dist/drizzle/sqlite.d.ts",
			"import": "./dist/drizzle/sqlite.js",
			"default": "./dist/drizzle/sqlite.js"
		},
		"./schema": {
			"types": "./dist/drizzle/schema.d.ts",
			"import": "./dist/drizzle/schema.js",
			"default": "./dist/drizzle/schema.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"type-check": "tsgo --noEmit && tsgo -p tsconfig.test.json --noEmit",
		"format": "oxfmt \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "oxlint src --fix && tsc --noEmit",
		"test": "vitest run",
		"test:docker": "sh -c 'docker compose -f docker-compose.test.yml up -d --wait && TANDEM_DOCKER_TESTS=1 vitest run; status=$?; docker compose -f docker-compose.test.yml down; exit $status'"
	},
	"dependencies": {
		"@tanishqkancharla/tandem-core": "workspace:*"
	},
	"peerDependencies": {
		"drizzle-orm": "^0.44.0"
	},
	"peerDependenciesMeta": {
		"drizzle-orm": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^20.14.2",
		"@types/better-sqlite3": "^7.6.13",
		"@tursodatabase/database": "^0.7.2",
		"better-sqlite3": "^11.10.0",
		"drizzle-orm": "^0.44.0",
		"mysql2": "^3.14.1",
		"postgres": "^3.4.5",
		"typescript": "^5.7.2",
		"vitest": "^1.1.0"
	}
}
