{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"composite": true,
		// Shared core runs in every JavaScript runtime, so it sees only ECMAScript
		// and the globals in src/globals.d.ts. src/browser and src/node build
		// through tsconfig.browser.json and tsconfig.node.json.
		"lib": ["ESNext", "ESNext.Disposable"],
		"types": []
	},
	"include": ["src/**/*.ts"],
	"exclude": [
		"dist",
		"node_modules",
		"src/**/*.spec.ts",
		"src/**/*.types.ts",
		"src/browser/**",
		"src/node/**"
	]
}
