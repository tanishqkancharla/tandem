{
	"name": "@tanishqkancharla/tandem-core",
	"version": "0.3.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"source": "./src/index.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./internal": {
			"types": "./dist/internal.d.ts",
			"import": "./dist/internal.js",
			"default": "./dist/internal.js"
		},
		"./node": {
			"types": "./dist/utils/Logger.node.d.ts",
			"import": "./dist/utils/Logger.node.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "Tanishq Kancharla <tanishqkancharla3@gmail.com>",
	"description": "Core sync engine functionality for Tandem",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tanishqkancharla/tandem.git",
		"directory": "packages/core"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"!dist/**/*.map"
	],
	"scripts": {
		"build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
		"prepublishOnly": "pnpm run build",
		"type-check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
		"format": "oxfmt \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "oxlint src --fix && tsc --noEmit",
		"test": "vitest run --config ../../vitest.config.js"
	},
	"dependencies": {
		"@types/lodash-es": "^4.17.12",
		"errore": "^0.14.1",
		"idb": "^8.0.4",
		"lodash-es": "^4.18.1",
		"tuple-database": "github:tanishqkancharla/tuple-database#ebe6b84edbc1371d0eb611cf5ca28d2f76be38db"
	},
	"devDependencies": {
		"@tanishqkancharla/gatekeeper": "workspace:*",
		"extendable-expect": "^1.0.5",
		"fake-indexeddb": "^6.2.5",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
