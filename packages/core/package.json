{
	"name": "@tanishqkancharla/tandem-core",
	"version": "0.2.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"source": "./src/index.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./internal": {
			"types": "./dist/internal.d.ts",
			"import": "./dist/internal.js",
			"default": "./dist/internal.js"
		},
		"./node": {
			"types": "./dist/utils/Logger.node.d.ts",
			"import": "./dist/utils/Logger.node.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "Tanishq Kancharla <tanishqkancharla3@gmail.com>",
	"description": "Core sync engine functionality for Tandem",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tanishqkancharla/tandem.git",
		"directory": "packages/core"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc",
		"type-check": "tsgo --noEmit && tsgo -p tsconfig.test.json --noEmit",
		"format": "oxfmt \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "oxlint src --fix && tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@triplit/tuple-database": "^2.2.33",
		"@types/lodash-es": "^4.17.12",
		"errore": "^0.14.1",
		"idb": "^8.0.3",
		"lodash-es": "^4.17.21",
		"tuple-database": "^2.2.4"
	},
	"devDependencies": {
		"extendable-expect": "^1.0.5",
		"fake-indexeddb": "^6.2.5",
		"typescript": "^5.7.2",
		"vitest": "^1.1.0",
		"@tanishqkancharla/gatekeeper": "workspace:*"
	}
}
