{
	"name": "@tanishqkancharla/gatekeeper",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Control execution order and faults between service proxies",
	"license": "MIT",
	"main": "./dist/Gatekeeper.js",
	"types": "./dist/Gatekeeper.d.ts",
	"exports": {
		".": {
			"types": "./dist/Gatekeeper.d.ts",
			"import": "./dist/Gatekeeper.js",
			"default": "./dist/Gatekeeper.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.map"
	],
	"scripts": {
		"build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
		"type-check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
		"lint": "oxlint src test",
		"format": "oxfmt src test vitest.config.ts",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"errore": "^0.14.1"
	}
}
