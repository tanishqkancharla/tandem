{
	"name": "@tandem/core",
	"version": "0.2.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"packageManager": "pnpm@10.12.4",
	"author": "Tanishq Kancharla <tanishqkancharla3@gmail.com>",
	"description": "A sync engine and database for building collaborative apps",
	"license": "MIT",
	"repository": {
		"url": "https://github.com/tanishqkancharla/tandem"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
		"type-check": "pnpm typecheck"
	},
	"dependencies": {
		"idb": "^8.0.3",
		"tuple-database": "^2.2.4"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^20.14.2",
		"better-sqlite3": "^11.10.0",
		"drizzle-orm": "^0.44.0",
		"extendable-expect": "^1.0.5",
		"fake-indexeddb": "^6.2.5",
		"mysql2": "^3.14.1",
		"postgres": "^3.4.5",
		"typescript": "^5.7.2",
		"vitest": "^1.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild"
		]
	}
}
