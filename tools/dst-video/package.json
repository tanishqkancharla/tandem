{
	"name": "@tandem/dst-video",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Renders videos of DST known failures and their proposed fixes with Remotion",
	"scripts": {
		"format": "oxfmt \"src\"",
		"lint": "oxlint src --deny-warnings",
		"render": "tsx src/render.ts",
		"studio": "remotion studio src/index.ts",
		"type-check": "tsc --noEmit"
	},
	"devDependencies": {
		"@remotion/bundler": "4.0.533",
		"@remotion/cli": "4.0.533",
		"@remotion/renderer": "4.0.533",
		"@tanishqkancharla/tandem-core": "workspace:*",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"remotion": "4.0.533",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
