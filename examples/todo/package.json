{
	"name": "@tandem/example-todo",
	"private": true,
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"dev": "pnpm --workspace-root exec turbo run dev --filter=@tandem/example-todo-web --filter=@tandem/example-todo-server",
		"build": "pnpm --workspace-root exec turbo run build --filter=@tandem/example-todo-web --filter=@tandem/example-todo-server",
		"type-check": "pnpm --workspace-root exec turbo run type-check --filter=@tandem/example-todo-web --filter=@tandem/example-todo-server",
		"test": "pnpm --workspace-root exec turbo run test --filter=@tandem/example-todo-server",
		"test:e2e": "pnpm --workspace-root exec turbo run test:e2e --filter=@tandem/example-todo-web"
	}
}
