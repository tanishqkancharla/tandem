{
	"name": "@tandem/example-todo-server",
	"private": true,
	"type": "module",
	"description": "Hono API backed by TandemServer JSON storage",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"build": "tsc --noEmit",
		"type-check": "tsc --noEmit",
		"lint": "oxlint src --deny-warnings",
		"format": "oxfmt \"src/**/*.ts\""
	},
	"dependencies": {
		"@hono/node-server": "^2.1.3",
		"@tandem/example-todo-shared": "workspace:*",
		"@tanishqkancharla/tandem-core": "workspace:*",
		"@tanishqkancharla/tandem-server": "workspace:*",
		"errore": "^0.14.1",
		"hono": "^4.13.13"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
