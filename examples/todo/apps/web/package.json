{
	"name": "@tandem/example-todo-web",
	"private": true,
	"type": "module",
	"description": "Todo web client using Tandem and Maui",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"type-check": "tsc --noEmit",
		"test:e2e": "playwright test",
		"lint": "oxlint src e2e vite.config.ts playwright.config.ts --deny-warnings",
		"format": "oxfmt \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" *.ts"
	},
	"dependencies": {
		"@tandem/example-todo-shared": "workspace:*",
		"@tanishqkancharla/maui": "^0.0.47",
		"@tanishqkancharla/tandem-core": "workspace:*",
		"@tanishqkancharla/tandem-react": "workspace:*",
		"errore": "^0.14.1",
		"purse-styles": "^0.2.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.3"
	}
}
